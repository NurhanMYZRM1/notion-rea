{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workspace-dev",
  "main": "src/index.ts",
  "account_id": "f51018eeed73777b08a81d5ca30ab318",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/sync/*", "/events/*", "/mcp", "/mcp/*", "/oauth/*", "/authorize", "/.well-known/*"]
  },
  "vars": {
    "ENVIRONMENT": "development",
    "PUBLIC_URL": "http://localhost:5173",
    "TEST_LOGIN": "enabled"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "workspace-dev", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "workspace-dev-files" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
  "durable_objects": {
    "bindings": [
      { "name": "PAGE", "class_name": "PageDocument" },
      { "name": "WORKSPACE", "class_name": "WorkspaceChannel" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PageDocument", "WorkspaceChannel"] }],
  "ratelimits": [{ "name": "API_LIMIT", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } }],
  "triggers": { "crons": ["17 3 * * *"] }
}
