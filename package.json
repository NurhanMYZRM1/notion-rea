{
  "name": "workspace-monorepo",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter server dev",
    "build": "pnpm -r --filter=!mobile build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --deny-warnings apps packages",
    "test": "pnpm -r --filter=!mobile test",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "oxlint": "1.89.0",
    "typescript": "6.0.3"
  }
}
